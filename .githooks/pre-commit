#!/bin/sh
# The checks before a commit, enabled per clone with `git config core.hooksPath .githooks`:
#
# - issues/INDEX.md and issues/OPEN.md are kept in step with the issue files: whenever something in
#   issues/ is part of a commit, both are generated from the issue files as they are staged and
#   added to the commit. An issue file whose fields are missing or unknown refuses the commit.
# - Prose is wrapped by the rules of docs/CODING-GUIDELINES.md: `scripts/wrapping.sh` must find no
#   line too long, and none beginning with a dash, in the files a commit adds or changes that the
#   rules cover, read whole from the working tree; files the commit leaves out are not checked.
# - The code is laid out by the formatter, and the linter and the type checker stay silent, as
#   "Checks" in docs/CODING-GUIDELINES.md names them: each runs whenever code or its configuration
#   is part of a commit, on the working tree, so that changes that are not staged count too.
#
# `git commit --no-verify` skips all of them.
set -eu

if ! git diff --cached --quiet -- issues/; then
    staged=$(mktemp -d)
    trap 'rm -rf "$staged"' EXIT
    git ls-files -- 'issues/[0-9]*.md' | git checkout-index --prefix="$staged/" --stdin
    issues/generate.sh "$staged/issues"
    git add issues/INDEX.md issues/OPEN.md
fi

committed=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$committed" ]; then
    scripts/wrapping.sh $committed
fi

# `--locked` refuses a uv.lock that no longer fits the pyproject.toml files.
if ! git diff --cached --quiet -- '*.py' '*pyproject.toml' uv.lock; then
    uv run --locked --quiet ruff format --check
    uv run --locked --quiet ruff check
    uv run --locked --quiet mypy
fi
