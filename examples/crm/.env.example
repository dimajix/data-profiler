# The variables of the project. Copied to .env and completed there, they are read by the tool, but
# do not override what the environment of the process sets; .env is not committed.

# The password of the user profiler of the simulation environment.
SIMULATION_PASSWORD=profiler

# The certificate the simulation environment is reached by: the absolute path of
# simulation/trino/tls/trino.crt in the clone of the repository, such as
# C:\Users\me\data-profiler\simulation\trino\tls\trino.crt on Windows.
REQUESTS_CA_BUNDLE=/home/me/data-profiler/simulation/trino/tls/trino.crt

# The simulation environment is reached directly, never by a proxy.
NO_PROXY=localhost
